{
  "name": "notime",
  "version": "0.1.0",
  "description": "Focus mode for X: write, see what needs an answer, answer it. A single-user PWA on Cloudflare Workers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/finereli/notime"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "npm run check && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "icon": "./scripts/icons.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.0.0",
    "material-symbols": "^0.45.10",
    "playwright": "^1.50.0",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  },
  "dependencies": {
    "@xdevplatform/chat-xdk": "^0.5.2",
    "juicebox-sdk": "^0.3.7"
  }
}
