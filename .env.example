# Copy to .env (never committed) and fill in. scripts/secrets.mjs pushes these
# to the Worker; scripts/dev-vars.mjs writes .dev.vars for local development.

# From the X developer console, your app → Keys and tokens.
X_CLIENT_ID=            # OAuth 2.0 Client ID
X_CLIENT_SECRET=        # OAuth 2.0 Client Secret (also signs webhook deliveries)
X_BEARER_TOKEN=         # App-only Bearer Token (webhooks, replay)
X_SECRET_KEY=           # OAuth 1.0a "Secret Key" (consumer secret, older webhook signatures)

# Made by `node scripts/vapid.mjs <https://your-site>`. Never regenerate once
# phones have subscribed to push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
