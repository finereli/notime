{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notime",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // One Worker serves the built app and the API. The API runs first so the
  // SPA fallback never swallows it.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "notime.finereli.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notime-db",
      "database_id": "553baba7-8144-4c9c-8caf-fe2d83448c44",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "OWNER_USERNAME": "finereli" },
  // Without this, local dev reports the production hostname from the route
  // above, and the dev bypass (which insists on a local host) never engages.
  "dev": { "ip": "127.0.0.1", "port": 8787, "host": "127.0.0.1:8787" },
  "observability": { "enabled": true }
}
