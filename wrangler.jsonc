{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notime",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // One Worker serves the built app and the API. The API runs first so the
  // SPA fallback never swallows it.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "notime.finereli.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notime-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "OWNER_USERNAME": "finereli" },
  "observability": { "enabled": true }
}
